# Phala CVM NixOS Configuration
# Copy this file to .env and update the values

# Git Repository Configuration
# Replace with your fork of wrlx-nixos-config
GITHUB_REPO=https://github.com/yourusername/wrlx-nixos-config.git
# Specific commit hash or branch name (main, develop, etc.)
GIT_COMMIT_HASH=main
# Set to true to force update code on restart
UPDATE_CODE=false

# VNC Configuration
# IMPORTANT: Change this to a secure password!
VNC_PASSWORD=changeme
# Display resolution (default: 1920x1080)
VNC_RESOLUTION=1920x1080

# SSH Configuration (internal container port)
SSH_PORT=22

# Phala Cloud Environment Variables
# These are automatically populated by Phala Cloud CVM
# Do not set these manually - they will be injected at runtime
#AGENT_DOMAIN=https://${DSTACK_APP_ID}.${DSTACK_GATEWAY_DOMAIN}
#DSTACK_APP_ID=
#DSTACK_GATEWAY_DOMAIN=
