# Phala CVM NixOS Configuration
# Copy this file to .env and update the values
#
# Note: Port and service configurations are in config/services.conf
# This file contains runtime environment variables only.

# Git Repository Configuration
# Replace with your fork if customizing
GITHUB_REPO=https://github.com/HashWarlock/wrlx-nixos-config.git
# Specific commit hash or branch name (main, develop, HEAD)
GIT_COMMIT_HASH=HEAD
# Set to true to force update code on restart
UPDATE_CODE=false

# VNC Configuration
# IMPORTANT: Change this to a secure password!
VNC_PASSWORD=changeme
# Display resolution (default: 1920x1080)
VNC_RESOLUTION=1920x1080

# Agent API Configuration
# These can be used to override defaults from services.conf
#AGENT_LISTEN_ADDR=0.0.0.0:8080
#AGENT_DB_PATH=./data/agent.db
#AGENT_SKILLS_DIR=/app/cvm-agent/skills
#AGENT_WORKING_DIR=/app
#AGENT_FLAKE_REF=/app#phala-cvm

# LLM Configuration (required for agent functionality)
# Get your API key from redpill.ai
REDPILL_API_KEY=your-api-key-here
REDPILL_BASE_URL=https://api.redpill.ai
REDPILL_MODEL=z-ai/glm-4.6

# Whisper Configuration (for voice transcription)
# Available models: tiny, base, small, medium, large
WHISPER_MODEL=base

# Phala Cloud Environment Variables
# Auto-populated in CVM deployment, leave empty for local development
AGENT_DOMAIN=
DSTACK_APP_ID=
DSTACK_GATEWAY_DOMAIN=
